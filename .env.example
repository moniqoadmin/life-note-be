# Copy this file to .env and fill in real values. Never commit .env.
# All variables here are validated at startup by src/lib/env.ts — the app
# fails fast with a clear error instead of misbehaving with an undefined secret.

# Postgres connection string used by Prisma.
# For serverless/scaled deployments, route through a pooler (PgBouncer / Prisma
# Accelerate / your provider's pooled connection string) and cap concurrency with
# `?connection_limit=<n>&pool_timeout=<s>` — a raw Postgres connection per
# lambda/edge instance exhausts the DB's max_connections quickly under load.
DATABASE_URL="postgresql://user:password@localhost:5432/life_note?schema=public"

# NextAuth/Auth.js session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# SMTP credentials used to send OTP emails (verification / password reset).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Life Note <no-reply@example.com>"
